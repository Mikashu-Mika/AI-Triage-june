# Server Port
PORT=4000

# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# AI Jaika (tried first, during its opening hours)
JAIKA_BASE_URL=https://your-jaika-host/v1
JAIKA_API_KEY=sk-jaika-your-key
# Bangkok time; several ranges "09:00-12:00,15:00-18:00", or "always"
JAIKA_OPEN_HOURS=15:00-18:00
# JAIKA_MODEL_CHAT=qwen2.5-14b
# JAIKA_MODEL_FAST=qwen2.5-3b
# JAIKA_MODEL_EMBEDDING=bge-m3

# Cloudflare Workers AI (fallback when Jaika is closed or busy)
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# Ollama LLM & Embedding Models (last fallback, local)
OLLAMA_URL=http://localhost:11434
# Context window (tokens) for the classification LLM; prompt + output must fit or Ollama truncates silently
OLLAMA_NUM_CTX=8192
# How long Ollama keeps the model in memory after a request (default 60m; reloading a 14B model is slow)
# OLLAMA_KEEP_ALIVE=60m
# Max wait (ms) for one LLM call of the executive Telegram assistant (default 900000 = 15 minutes, for CPU-only machines)
# AGENT_LLM_TIMEOUT_MS=900000
MODEL_LLM=qwen2.5:14b
MODEL_EMBEDDING=bge-m3
# Optional: separate model for the executive Telegram assistant (defaults to MODEL_LLM)
# MODEL_AGENT=qwen2.5:14b

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_ALLOWED_CHAT_IDS=123456789,987654321
TELEGRAM_WEBHOOK_URL=
# TELEGRAM_WEBHOOK_SECRET=
# Executive group for the Monday weekly summary
# TELEGRAM_EXEC_GROUP_ID=
# WEEKLY_SUMMARY_ENABLED=true
# Daily summary time, Bangkok (default 11:00)
# BRIEFING_TARGET_HOUR=11
# BRIEFING_TARGET_MINUTE=0

# Admin API Key (required, min 32 chars) - generate with: openssl rand -hex 32
ADMIN_API_KEY=
