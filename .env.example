# Server Port
PORT=4000

# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_ANON_KEY=your-supabase-anon-key

# Ollama LLM & Embedding Models
OLLAMA_URL=http://localhost:11434
# Context window (tokens) for the classification LLM; prompt + output must fit or Ollama truncates silently
OLLAMA_NUM_CTX=8192
# How long Ollama keeps the model in memory after a request (default 60m; reloading a 14B model is slow)
# OLLAMA_KEEP_ALIVE=60m
# Max wait (ms) for one LLM call of the executive Telegram assistant (default 900000 = 15 minutes, for CPU-only machines)
# AGENT_LLM_TIMEOUT_MS=900000
MODEL_LLM=qwen2.5:14b
MODEL_EMBEDDING=bge-m3
# Optional: separate model for the executive Telegram assistant (defaults to MODEL_LLM)
# MODEL_AGENT=qwen2.5:14b

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_ALLOWED_CHAT_IDS=123456789,987654321
TELEGRAM_WEBHOOK_URL=

# Admin API Key (required, min 32 chars) - generate with: openssl rand -hex 32
ADMIN_API_KEY=
